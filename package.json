{
  "name": "3g-eletronicos",
  "version": "1.0.0",
  "description": "Api, express, typeorm, node, swagger, supertest, jest",
  "license": "MIT",
  "author": "Prof",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts,js --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "seed": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "typeorm": "node --require ts-node/register node_modules/typeorm/cli.js -d src/config/data-source.ts",
    "test": "jest"
  },
  "dependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node": "^24.6.0",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typeorm": "^0.3.26"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}